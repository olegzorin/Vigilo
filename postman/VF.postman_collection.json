    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Report Groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/groups/{{organizationId}}?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "groups", "{{organizationId}}"],
              "query": [{ "key": "all", "value": "true" }]
            }
          }
        },
        {
          "name": "Assign Report Group to Organization",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/groups/{{organizationId}}?reportGroupId={{reportGroupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "groups", "{{organizationId}}"],
              "query": [{ "key": "reportGroupId", "value": "{{reportGroupId}}" }]
            },
            "description": "Requires an admin of the target organization or an ancestor. Existing inherited assignments are left unchanged; a new assignment removes descendant assignments for the same group."
          }
        },
        {
          "name": "Get Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/reports?organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "reports"],
              "query": [{ "key": "organizationId", "value": "{{organizationId}}" }]
            }
          }
        },
        {
          "name": "Generate Report (Database Backed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/generate?reportId={{reportId}}&organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "generate"],
              "query": [
                { "key": "reportId", "value": "{{reportId}}" },
                { "key": "organizationId", "value": "{{organizationId}}" }
              ]
            },
            "description": "Runs synchronously. ZIPs up to 64,000 bytes are stored in report_execution_history.output; larger ZIPs are uploaded to the configured reports S3 bucket under the execution object ID."
          }
        },
        {
          "name": "Get Scheduled Report Executions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/data?startDate={{reportStartDate}}&endDate={{reportEndDate}}&reportId={{reportId}}&reportGroupId={{reportGroupId}}&organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "data"],
              "query": [
                { "key": "startDate", "value": "{{reportStartDate}}" },
                { "key": "endDate", "value": "{{reportEndDate}}" },
                { "key": "reportId", "value": "{{reportId}}" },
                { "key": "reportGroupId", "value": "{{reportGroupId}}" },
                { "key": "organizationId", "value": "{{organizationId}}" }
              ]
            }
          }
        },
        {
          "name": "Download Report Output",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/data/{{reportDownloadToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "data", "{{reportDownloadToken}}"]
            },
