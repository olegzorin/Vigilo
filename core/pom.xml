    <build>
        <finalName>dev.olegz.vf.core</finalName>

        <plugins>
            <!-- Set home directory and version in JAR manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin-version}</version>
                <configuration>
                    <archive>
                        <manifestSections>
                            <manifestSection>
                                <name>${manifest.home.entry}</name>
                                <manifestEntries>
                                    <version>${project.parent.version}</version>
                                    <!--suppress UnresolvedMavenProperty -->
                                    <revision>${git.commit.id.abbrev}</revision>
                                    <!--suppress UnresolvedMavenProperty -->
                                    <time>${git.commit.time}</time>
                                    <!--suppress UnresolvedMavenProperty -->
                                    <repositoryPath>${git.branch}</repositoryPath>
                                </manifestEntries>
                            </manifestSection>
                        </manifestSections>
                    </archive>
                    <excludes>
                        <exclude>logback-test.xml</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests coverage report -->
            <!-- plugin>
                <groupId>org.jacoco</groupId>
