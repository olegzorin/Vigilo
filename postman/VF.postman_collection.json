          }
        },
        {
          "name": "Download Report Output as JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/data/{{reportDownloadToken}}?responseFormat=1",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "data", "{{reportDownloadToken}}"],
              "query": [{ "key": "responseFormat", "value": "1" }]
            },
            "description": "Verifies the signed report JWT, unpacks the CSV, and returns JSON."
          }
        }
      ]
    }
