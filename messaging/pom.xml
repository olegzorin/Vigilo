<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.olegz.vf</groupId>
        <artifactId>parent</artifactId>
        <version>1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>messaging</artifactId>
    <packaging>jar</packaging>
    <name>Vigilo Framework Messaging</name>
    <description>Message streaming layer: broker-agnostic producer/listener SPI (dev.olegz.vf.messaging)
        and its Kafka implementation (dev.olegz.vf.messaging.kafka). Additional brokers (RabbitMQ, Artemis)
        plug in as sibling implementation packages.</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${jupiter-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${jupiter-version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.olegz.vf</groupId>
            <artifactId>foundation</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>dev.olegz.vf</groupId>
            <artifactId>aws</artifactId>
            <version>1</version>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.11.1</version>
        </dependency>
        <dependency>
            <groupId>org.xerial.snappy</groupId>
            <artifactId>snappy-java</artifactId>
            <version>1.1.10.8</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>4.3.1</version>
        </dependency>
        <!-- End of Kafka -->

        <!-- Artemis (core client) -->
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-core-client</artifactId>
            <version>2.55.0</version>
        </dependency>
        <!-- End of Artemis -->
    </dependencies>

    <build>
        <finalName>dev.olegz.vf.messaging</finalName>
    </build>
</project>
