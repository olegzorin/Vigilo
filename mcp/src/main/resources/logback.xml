<configuration>

    <!-- stdio transport: stdout is the JSON-RPC channel, so ALL logging goes to stderr.
         This config is intentionally self-contained (it does NOT include the home
         logback-inc.xml, which may log to stdout). -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.olegz.vf.mcp" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
